# ==============================================================================
# NEXUS CORE OS - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application Settings
APP_ENV=production
DEBUG=false
APP_SECRET=your_super_secret_jwt_encryption_key_change_in_production
ALLOWED_ORIGINS=https://app.nexusos.id,https://admin.nexusos.id

# Managed PostgreSQL Database (Supabase / RDS with pgvector)
POSTGRES_DB=nexus_db
POSTGRES_USER=nexus_admin
POSTGRES_PASSWORD=your_secure_db_password
DATABASE_URL=postgresql://nexus_admin:your_secure_db_password@localhost:5432/nexus_db

# Redis Caching & Queue
REDIS_URL=redis://localhost:6379/0

# AI Models & LLM Inference (CommerceOS Model Routing)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
QWEN_API_KEY=your_qwen_dashscope_api_key_here

# Voice Synthesis & Audio Generation (Domain B)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
EDGE_TTS_VOICE=id-ID-GadisNeural

# Multi-Channel Publishing APIs (Domain C)
YOUTUBE_API_CLIENT_ID=your_google_cloud_oauth_client_id.apps.googleusercontent.com
YOUTUBE_API_CLIENT_SECRET=your_google_client_secret
TIKTOK_APP_ID=your_tiktok_for_developers_app_id
TIKTOK_APP_SECRET=your_tiktok_app_secret
META_GRAPH_ACCESS_TOKEN=your_meta_system_user_token_for_instagram

# Storage & CDN (Cloudflare R2 / AWS S3)
STORAGE_BUCKET=nexus-rendered-media
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_PUBLIC_URL=https://cdn.nexusos.id
